@using OpenIddict.EntityFrameworkCore.Models

@code {
  [Parameter] public List<OpenIddictEntityFrameworkCoreApplication> Model { get; set; } = [];
}
<div class="shadow-sm" id="client-inventory-list">
  <div class="card-header bg-light d-flex flex-row justify-content-between align-items-center">
    <h5 class="mb-0 text-secondary">Active Registered Applications</h5>
    <button class="btn-solid theme-success" commandfor="newClientDialog" command="show-modal" aria-description="Add new OIDC Application">+</button>
  </div>
  <div class="card-body p-0">
    @if (!Model.Any())
    {
      <div class="p-4 text-center text-muted">
        <p class="mb-0">No active client applications registered.</p>
      </div>
    }
    else
    {
      <div class="list-group list-group-flush">
        @foreach (var client in Model)
        {
          <div class="list-group-item d-flex justify-content-between align-items-center p-3">
            <div>
              <h6 class="mb-1 text-dark">@client.DisplayName</h6>
              <div class="small text-muted font-monospace">Client ID: @client.ClientId</div>
            </div>
            <div class="text-end">
              <span class="chip bg-secondary mb-1">@client.ClientType</span>
            </div>
            <button
              hx-delete="/api/client?clientId=@client.ClientId"
              hx-confirm="Are you sure?"
              class="btn-solid theme-danger"
              >Delete</button>
          </div>
        }
      </div>
    }
  </div>
</div>
