<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="/lib/bootstrap/boostrap.min.css">
    <link rel="stylesheet" href="/css/site.css"/>
    <HeadOutlet/>
    <title>YAuth</title>

</head>

<body>
<Routes/>

<script src="lib/htmx/htmx.min.js"></script>
<script defer src="lib/alpine/alpine.min.js"></script>
<script type="module" src="lib/bootstrap/bootstrap.bundle.min.js"></script>


<div class="visually-hidden" id="blazor-antiforgery">
    <AntiforgeryToken/>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("blazor-antiforgery");
        const tokenInput = container ? container.querySelector("input[type='hidden']") : null;

        if (tokenInput) {
            const tokenValue = tokenInput.value;
            document.body.addEventListener('htmx:config:request', (evt) => {
                evt.detail.ctx.request.headers['RequestVerificationToken'] = tokenValue;
            });
        }

        document.body.addEventListener('htmx:response:error', function(e) {
            let message = e.detail.ctx.text;
            console.error(message);
            alert(message);
        })
    });
</script>
</body>

</html>