@page "/setup"
@using YAuth.Components.Shared
@using YAuth.Endpoints

<div class="container d-flex justify-content-center align-items-center my-5">
    <div class="card bg-dark text-white border-secondary p-4 shadow" style="width: 100%; max-width: 440px; border-radius: 1rem;">
        
        <div class="card-body">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold text-light mb-1">YAuth Setup</h1>
                <p class="small  mb-0">Set up your Admin Credentials.</p>
            </div>
            
            <div id="errors"></div>

            <DynamicForm
                TModel="SetupModel"
                hx-post="/api/setup/initialize"
                hx-swap="errors"
                />
        </div>

    </div>
</div>