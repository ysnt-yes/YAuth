@page "/user"
@attribute [Authorize(Policy = Policies.AdminPolicy)]
@using Microsoft.AspNetCore.Identity
@using YAuth.Components.Shared
@inject UserManager<User> UserManager
@inject RoleManager<IdentityRole> RoleManager

<table class="table">
  <thead>
  <tr>
    <th>Username</th>
    <th>Roles</th>
    <th>Login Types</th>
  </tr>
  </thead>
  <tbody>
  @foreach (var row in _userData)
  {
    <tr>
      <td>@row.User.UserName</td>
      <td id="user-row_@row.User.Id">
        <UserRow UserId="@row.User.Id" AssignedRoles="row.AssignedRoles" UnassignedRoles="row.UnassignedRoles"/>
      </td>
      <td>@string.Join(", ", row.Logins)</td>
    </tr>
  }
  </tbody>
</table>


@code {

  private record UserRowModel(
    User User,
    IEnumerable<string> AssignedRoles,
    IEnumerable<string> UnassignedRoles,
    IEnumerable<string> Logins);

  private List<UserRowModel> _userData = [];
  private List<string> _allRoles = [];

  protected override async Task OnInitializedAsync()
  {
    _allRoles = RoleManager.Roles
      .Select(r => r.Name)
      .Where(name => name != null)
      .ToList()!;

    var users = UserManager.Users.ToList();
    var tasks = users.Select(async user =>
    {
      var roles = await UserManager.GetRolesAsync(user);
      var logins = await GetUserAuthMethods(user);
      var unassigned = _allRoles.Where(r => !roles.Contains(r)).ToList();

      return new UserRowModel(
        User: user,
        AssignedRoles: roles,
        UnassignedRoles: unassigned,
        Logins: logins
      );
    });

    _userData = (await Task.WhenAll(tasks)).ToList();
  }

  private async Task<IEnumerable<string>> GetUserAuthMethods(User user)
  {
    List<string> result = [];

    if (await UserManager.HasPasswordAsync(user))
    {
      result.Add("Password");
    }

    if (await UserManager.GetTwoFactorEnabledAsync(user))
    {
      result.Add("MFA");
    }

    var passkeys = await UserManager.GetPasskeysAsync(user);
    if (passkeys.Any())
    {
      result.Add("Passkey");
    }

    var logins = await UserManager.GetLoginsAsync(user);
    if (logins.Any())
    {
      result.AddRange(logins.Select(l => l.ProviderDisplayName ?? l.LoginProvider));
    }

    return result;
  }

}
