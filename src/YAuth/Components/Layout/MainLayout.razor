@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inherits LayoutComponentBase
@inject UserManager<User> UserManager
@inject NavigationManager Navigation


<div class="page">
  <nav class="navbar md:navbar-expand bg-1 container-fluid gap-4 justify-content-start">
    <NavLink class="navbar-brand mb-0 h1" href="/">YAuth</NavLink>
    <NavLink href="/clients">Clients</NavLink>
    <NavLink href="/user">Users</NavLink>
  </nav>

  <AuthorizeView>
    <Authorized>
      <form action="/auth/logout" method="post">
        <button class="nav-link btn-link theme-danger">Log out</button>
      </form>
    </Authorized>
    <NotAuthorized>
      <NavLink href="/login">Login</NavLink>
    </NotAuthorized>
  </AuthorizeView>


  <main class="container d-flex justify-content-center align-items-center my-5">
      <div class="card bg-dark text-white border-secondary p-4 shadow"
           style="width: 100%; max-width: 80%; min-width: fit-content; border-radius: 1rem;">
        @Body
      </div>
  </main>
</div>

@code {
  protected override async Task OnInitializedAsync()
  {
    var totalUsers = await UserManager.Users.CountAsync();

    var isOnSetup = Navigation.Uri.Contains("/setup");
    if (totalUsers == 0 && !isOnSetup)
    {
      Navigation.NavigateTo("/setup");
    }
  }
}